# Copiá este archivo como .env.local y completá los dos valores.
# .env.local no se sube al repo: cada uno tiene el suyo.
#
# Los dos salen de Supabase → Project Settings → API Keys.
#
# Ojo: acá va SÓLO la clave pública (dice "anon" o "publishable", y empieza con
# eyJ... o con sb_publishable_). Es la que viaja al navegador y no pasa nada si
# se ve. La otra, la "service_role" o "secret", NO va acá ni en ningún lado del
# proyecto: esa saltea todos los permisos.

# La URL es el "Project URL". No el endpoint REST, que se parece pero termina
# en /rest/v1/ y hace fallar todo con "Invalid path specified in request URL".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Con una de las dos alcanza. La de arriba es el nombre nuevo de la de abajo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
